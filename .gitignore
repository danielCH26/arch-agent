# =============================================================================
# .gitignore — Asistente de Arquitectura
# =============================================================================

# --- Python & Entornos Virtuales ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Variables de entorno y secretos ---
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# --- Logs y Bases de datos ---
*.log
logs/
*.sqlite3

# --- IDEs y Sistema Operativo ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Chainlit ---
.chainlit/
.files/
chainlit.md

# --- Docker y Caches locales ---
docker-data/
.langfuse/
.engram/

# --- Datos temporales y subidas ---
uploads/
temp/
*.pdf
*.md
!README.md