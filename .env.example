# =============================================================================
# arch-agent — Variables de entorno (ejemplo)
# =============================================================================
# Copiar a .env y completar con valores reales:
#   cp .env.example .env
#
# IMPORTANTE: NUNCA commitear .env al repo (está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Encriptación (HU12)
# -----------------------------------------------------------------------------
# Generar con: python scripts/generate_encryption_key.py
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# En Docker Compose, el host es "postgres-app"
# Para desarrollo local fuera de Docker: "localhost"
DATABASE_URL=postgresql://asistente:asistente@postgres-app:5432/asistente_db

# -----------------------------------------------------------------------------
# Langfuse (Observabilidad)
# -----------------------------------------------------------------------------
# Defaults de docker-compose. Si usás Langfuse Cloud, cambiar la URL.
LANGFUSE_PUBLIC_KEY=pk-lf-demo
LANGFUSE_SECRET_KEY=sk-lf-demo
LANGFUSE_BASE_URL=http://langfuse-web:3000

# -----------------------------------------------------------------------------
# MCPs externos (opcional)
# -----------------------------------------------------------------------------
# Context7: https://mcp.context7.com
CONTEXT7_API_KEY=

# Web Search: Tavily / Exa / etc.
WEB_SEARCH_API_KEY=
WEB_SEARCH_URL=https://mcp.tavily.com/mcp

# -----------------------------------------------------------------------------
# Redis (interno de Langfuse)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=myredissecret

# -----------------------------------------------------------------------------
# Configuración del LLM (defaults - el usuario override desde UI)
# -----------------------------------------------------------------------------
# Default para desarrollo local con Ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3

# -----------------------------------------------------------------------------
# NextAuth (solo si usás Langfuse cloud)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=cambiar-en-produccion
LANGFUSE_INIT_USER_EMAIL=admin@asistente.local
LANGFUSE_INIT_USER_PASSWORD=admin123
