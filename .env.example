# =============================================================================
# .env.example — Plantilla de variables de entorno
# Copia este archivo como `.env` y rellena los valores reales:
#     cp .env.example .env
# NO commitees el .env real al repo (esta en .gitignore).
# =============================================================================

# ----------------------------------------------------------------------------
# JWT (API auth — replaces Chainlit session cookies)
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
APP_NAME=Arch Agent

# ----------------------------------------------------------------------------
# Postgres (DB de la app — datos relacionales + PGVector para RAG)
# ----------------------------------------------------------------------------
POSTGRES_USER=asistente
POSTGRES_PASSWORD=asistente
POSTGRES_DB=asistente_db

# ----------------------------------------------------------------------------
# Langfuse (tracing / observabilidad de LLM)
# Valores SOLO para desarrollo local. Cámbialos si despliegas en un servidor.
# ----------------------------------------------------------------------------
LANGFUSE_SALT=cambiar-en-produccion-32-chars-min-random
NEXTAUTH_SECRET=cambiar-en-produccion-please

# Provisión automática en el primer arranque (org, proyecto, admin y keys).
LANGFUSE_INIT_ORG_ID=asistente-org-id
LANGFUSE_INIT_ORG_NAME=asistente-org
LANGFUSE_INIT_PROJECT_ID=asistente-prod-id
LANGFUSE_INIT_PROJECT_NAME=asistente-prod
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-asistente-prod
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-asistente-prod-secret-cambiar
LANGFUSE_INIT_USER_EMAIL=admin@asistente.local
LANGFUSE_INIT_USER_PASSWORD=admin123
LANGFUSE_INIT_USER_NAME=Admin

# Keys que usa el backend (la app), separadas de las de arriba porque
# cumplen roles distintos: las LANGFUSE_INIT_PROJECT_*_KEY de arriba SOLO
# se leen una vez, en el primer arranque de langfuse-web, para crear el
# proyecto con esas keys ya fijas. Las de aca abajo son las que el SDK
# del backend usa en cada llamada. Deben tener el MISMO VALOR que las de
# arriba (si no coinciden: 401 Unauthorized silencioso al exportar trazas,
# el chat sigue funcionando pero nada llega a Langfuse).
LANGFUSE_PUBLIC_KEY=pk-lf-asistente-prod
LANGFUSE_SECRET_KEY=sk-lf-asistente-prod-secret-cambiar
LANGFUSE_BASE_URL=http://localhost:3000

# Postgres dedicado a Langfuse (no compartir con POSTGRES_* de la app).
LANGFUSE_DB_USER=postgres
LANGFUSE_DB_PASSWORD=postgres
LANGFUSE_DB_NAME=postgres

# ----------------------------------------------------------------------------
# ClickHouse (analytics de Langfuse)
# ----------------------------------------------------------------------------
CLICKHOUSE_DB=default
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# ----------------------------------------------------------------------------
# MinIO (storage S3-compatible de Langfuse)
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
S3_BUCKET=langfuse
S3_REGION=us-east-1

# ----------------------------------------------------------------------------
# Redis (cache de Langfuse)
# ----------------------------------------------------------------------------
REDIS_PASSWORD=myredissecret

# ----------------------------------------------------------------------------
# Engram (memoria persistente del agente)
# ----------------------------------------------------------------------------
ENGRAM_PROJECT=asistente-arquitectura
# URL para ejecutar la aplicación desde el equipo anfitrión.
# Puerto EXTERNO es 7439 (docker-compose mapea 7439 -> 7437 interno)
# para no chocar con un engram local del dev corriendo en :7437.
# Dentro de la red Docker, los servicios usan http://engram:7437.
ENGRAM_URL=http://localhost:7439

# ----------------------------------------------------------------------------
# Encriptación (HU12 — usado para encriptar API keys de LLM en users.llm_*)
# ----------------------------------------------------------------------------
# Generar con: python scripts/generate_encryption_key.py
ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# LLM (configurables luego desde la UI; estos son los defaults)
# Para Ollama local:   http://host.docker.internal:11434/v1
# Para LM Studio:      http://host.docker.internal:1234/v1
# Para OpenAI:         https://api.openai.com/v1
# ----------------------------------------------------------------------------
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3

# ----------------------------------------------------------------------------
# MCPs — API keys opcionales
# ----------------------------------------------------------------------------
CONTEXT7_API_KEY=
WEB_SEARCH_API_KEY=

# ----------------------------------------------------------------------------
# Puppeteer MCP (F13, issue #17) — render de diagramas Mermaid
# ----------------------------------------------------------------------------
# URL del sidecar puppeteer-mcp. Dentro de la red Docker el hostname del
# servicio es ``puppeteer-mcp`` y el MCP server escucha en :8931/mcp.
PUPPETEER_MCP_URL=http://puppeteer-mcp:8931/mcp
# Budget por llamada (segundos) sobre asyncio.wait_for.
PUPPETEER_RENDER_TIMEOUT_SECONDS=15
# Tope de bytes para la respuesta PNG (2 MB).
PUPPETEER_MAX_RENDER_BYTES=2097152
# Rate limit por usuario (renders / 60 s). 0 desactiva efectivamente el
# render — util para rollout por fases (ver design §7).
PUPPETEER_RENDER_RATE_LIMIT_PER_MINUTE=5

# --- F19: primera propuesta en < 5 min --------------------------------------
# Tope total (segundos) desde que se pide la propuesta hasta que se guarda; vale
# para todas las etapas (contexto, retrieval, LLM, guardado). Al agotarse se
# corta con error y no se guarda nada. 0 lo desactiva; vacío, no numérico o
# negativo vuelve a 300 con un warning.
PROPOSAL_MAX_SECONDS=300
# Segundos del final del tope reservados para guardar (max. 20 % del tope): el
# LLM y las busquedas deben terminar antes, asi una propuesta completa no se
# pierde por unos segundos de guardado.
PROPOSAL_SAVE_RESERVE_S=10
# Longitud tipica de una propuesta (caracteres); solo ajusta el % de la barra.
PROPOSAL_EXPECTED_CHARS=6000
# Separacion minima (s) entre eventos `progress` mientras llegan tokens.
PROPOSAL_PROGRESS_INTERVAL_S=1.0
# Precarga el modelo de embeddings al arrancar (off para desactivar).
EMBEDDINGS_WARMUP=on
# F19 — rendimiento RAG. La caché es sólo de embeddings de consultas y no
# contiene resultados ni datos de usuarios.
RAG_EMBEDDING_CACHE_SIZE=512
# Textos por llamada a embed_documents al indexar documentos. Solo acota la memoria
# por llamada; NO mejora la latencia (el batch interno de sentence-transformers,
# 32 por defecto, no cambia con esta variable).
EMBEDDING_BATCH_SIZE=64
# Segundos entre comentarios `: ping` del stream SSE de propuestas (mantienen viva la
# conexion ante proxies con idle timeout). Minimo 1; por debajo vuelve a 15 con warning.
# Debe ser menor que el `proxy_read_timeout` de frontend/nginx.conf (330 s, tope de
# 300 s + margen).
SSE_HEARTBEAT_SECONDS=15
#
# --- Pool de PostgreSQL y dimensionamiento de conexiones ---------------------
# El pool es POR PROCESO backend (cada worker de uvicorn tiene el suyo). Los
# defaults (10 + 20) superan los de SQLAlchemy (5 + 10). Valores vacíos o inválidos
# (p. ej. DB_POOL_RECYCLE=0) vuelven al default con warning.
#
# Dos condiciones, ambas necesarias:
#
#   1) Por proceso (evita timeouts del pool bajo carga):
#        DB_POOL_SIZE + DB_MAX_OVERFLOW  >=  RAG_SEARCH_WORKERS + H
#      donde H = hilos de asyncio.to_thread que abren sesion a la vez. El executor
#      por defecto de Python tiene min(32, CPUs + 4) hilos y lo usan la carga de
#      contexto y el guardado de propuestas, ademas de otras rutas. El warning de
#      arranque solo compara RAG_SEARCH_WORKERS con el pool; H no se valida.
#
#   2) Global (evita "too many connections" en PostgreSQL):
#        (DB_POOL_SIZE + DB_MAX_OVERFLOW) x procesos + otros clientes
#                                          <=  max_connections - reservadas
#      PostgreSQL trae max_connections=100 por defecto (3 reservadas para
#      superusuario). Ejemplo con los defaults: 30 x 3 procesos = 90 (ya casi al
#      limite); con 4 procesos son 120 > 100. Sube max_connections, baja el pool o
#      usa pgbouncer.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Hilos del executor de busquedas paralelas (scope=all), compartido por proceso.
# Cada rama de scope=all abre su propia sesion. Ver condicion 1 de arriba.
RAG_SEARCH_WORKERS=16
